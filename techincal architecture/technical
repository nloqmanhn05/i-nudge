## 2. Component Hierarchy & Data Flow

```mermaid
graph TD
    ROOT["ReactDOM.createRoot()"] --> EB["ErrorBoundary"]
    EB --> APP["App.jsx (Central State Hub)"]

    APP -->|"activeTab, dangerMode, toast, tour*"| SHELL["AppShell.jsx"]
    SHELL -->|"Header / Shortcuts / Toast"| SHELL_UI["Viewport Shell"]
    SHELL --> BNAV["BottomNav.jsx"]
    SHELL --> TC["TourCard.jsx (Overlay)"]

    SHELL -->|"renders active route"| ROUTE_ROUTER{"activeTab Router"}

    ROUTE_ROUTER -->|"!onboarded"| ONBOARD["OnboardingFlow.jsx"]
    ROUTE_ROUTER -->|"home"| HOME["Home.jsx"]
    ROUTE_ROUTER -->|"coach"| COACH["BudgetCoach.jsx"]
    ROUTE_ROUTER -->|"simulation"| SIM["Simulation.jsx"]
    ROUTE_ROUTER -->|"emergency"| EMERG["Emergency.jsx"]
    ROUTE_ROUTER -->|"profile"| PROF["Profile.jsx -> Settings.jsx"]

    ONBOARD -->|"onComplete(currency, userName)"| APP
    HOME -->|"onNavigate(tab), onExitDangerMode()"| APP
    COACH -->|"onLogSpending(), setLoggedSpending(), showToast()"| APP
    SIM -->|"onConfirmPurchase(), onProceed(), onPostpone()"| APP
    EMERG -->|"onAcknowledge()"| APP
    PROF -->|"onLogout(), onReplayTour()"| APP

    HOME --> DEBT_STACK_UI["DebtCard.jsx x N"]
    HOME --> ECG_CANVAS["EcgCanvas.jsx"]
    SIM --> SIM_FORM["Simulation Form"]
    SIM --> SIM_LOAD["SimLoadingScreen"]
    SIM --> SIM_RESULT["SimResultScreen"]
    SIM --> SIM_PROCEED["ProceedAnywayScreen"]
    SIM --> SIM_BLOCKED["DailyPoolBlockedScreen"]
```

