                EMERG["Emergency.jsx<br/>• Survival Score Calculator<br/>• Priority Action Checklist<br/>• Hardship Program Directory"]
                PROF["Profile.jsx / Settings.jsx<br/>• Financial Health Status<br/>• Notification Toggles<br/>• Logout & Tour Replay"]
            end
            
            subgraph UI_KIT["Reusable UI Components"]
                DEBT_CARD["DebtCard.jsx<br/>• BNPL Liability Card with Limit Progress"]
                ECG_CANVAS["EcgCanvas.jsx<br/>• Dynamic Heartbeat Pulse Waveform"]
                ONBOARD["OnboardingFlow.jsx<br/>• First-time User Activation Form"]
            end
        end
        
        subgraph DATA_LAYER["Data & Persistence"]
            MOCK["mockData.js<br/>• DEBT_STACK<br/>• NAV_ITEMS<br/>• TOUR_STEPS<br/>• HARDSHIP_INFO"]
