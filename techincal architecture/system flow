## 2. Logical Budget & Emergency Calculation Pipeline

```mermaid
flowchart TD
    subgraph INCOME_CALC["1. Total Income Calculation"]
        I1["Base Monthly Income (e.g. RM 3,200)"]
        I2["Logged Extra Income (from Coach transactions)"]
        I1 & I2 --> I_TOTAL["Total Active Income = Base + Extra Income"]
    end

    subgraph DEDUCTIONS["2. Mandatory Commitments"]
        D1["Fixed Bills (Rent, Utilities, Food)"]
        D2["Static BNPL Debt Stack (Grab, Shopee, Atome)"]
        D3["Simulated Active BNPL Items"]
        D2 & D3 --> BNPL_DUE["Total BNPL Due This Cycle"]
        D4["Savings Target (Total Income * Savings %)"]
    end

    subgraph POOL_CALC["3. Daily Allowance Calculation"]
        I_TOTAL --> POOL_EQ["Monthly Pool = Total Income - Fixed Bills - BNPL Due - Savings"]
        D1 & BNPL_DUE & D4 --> POOL_EQ
        POOL_EQ --> REM_POOL["Remaining Pool = Monthly Pool - Total Logged Expenses"]
        REM_POOL --> DAILY_DIV["Daily Budget = Remaining Pool / Days Left in Cycle"]
        DAILY_DIV --> TODAY_CMP{"Today's Spent vs Daily Budget"}
        TODAY_CMP -->|"< 60%"| STATUS_GREEN["🟢 On Track (Green)"]
        TODAY_CMP -->|"60% - 90%"| STATUS_AMBER["🟡 Tight (Amber)"]
        TODAY_CMP -->|"> 90%"| STATUS_RED["🔴 Over Budget (Red)"]
    end

    subgraph EMERGENCY_ENGINE["4. Emergency Health Engine"]
        I_TOTAL & D1 --> AVAIL["Available Income = Total Income - Fixed Bills"]
        BNPL_DUE & AVAIL --> SHORTFALL["Shortfall = BNPL Due - Available Income"]
        D1 --> BURN["Daily Burn Rate = Fixed Bills / 30"]
        LIQUID["Liquid Cash Reserve (RM 1,240.50)"] & BURN --> SURVIVAL["Survival Score Days = Liquid Cash / Burn Rate"]
        SHORTFALL & SURVIVAL --> CRISIS_CHECK{"Shortfall > 0 OR Survival Score < 30 Days?"}
        CRISIS_CHECK -->|"YES"| TRIG_EMERG["🚨 Emergency Mode Triggered (Badge Active)"]
        CRISIS_CHECK -->|"NO"| SAFE_EMERG["✅ Financial Vitals Stable"]
    end

    style I_TOTAL fill:#dcfce7,stroke:#16a34a,stroke-width:2px
    style DAILY_DIV fill:#e0f2fe,stroke:#0284c7,stroke-width:2px
    style TRIG_EMERG fill:#fee2e2,stroke:#dc2626,stroke-width:2px
    style SAFE_EMERG fill:#dcfce7,stroke:#16a34a,stroke-width:2px
```

