## 3. BNPL Purchase Simulation Decision Engine

```mermaid
flowchart TD
    INPUT["User Inputs:<br/>• Item Name<br/>• Total Price (RM)<br/>• Repayment Months (1-24)<br/>• Interest Rate (%)<br/>• Payment Provider"] --> VALIDATE{"Daily Pool >= RM 300?"}

    VALIDATE -->|"NO (Pool Depleted)"| BLOCKED_UI["🔒 DailyPoolBlockedScreen<br/>• Hard Lock on Simulation<br/>• Detailed Deficit Breakdown<br/>• Action Plan to Unlock"]
    
    VALIDATE -->|"YES"| RUN_SIM["Compute Financial Impact:<br/>• monthlyPay = (amount / duration) * (1 + interest%)<br/>• bufferImpact = (monthlyPay / Liquid Cash) * 100<br/>• totalImpact = (amount / Liquid Cash) * 100"]

    RUN_SIM --> ANIM["⏳ SimLoadingScreen<br/>• 3-Second Visual Analysis Pulse"]
    ANIM --> DECISION{"totalImpact >= 50%?"}

    DECISION -->|"NO (Safe < 50%)"| SAFE_UI["🟢 SimResultScreen (Safe)<br/>• Projected Liquidity Bar (Green)<br/>• Guardian Angel Safe Speech"]
    DECISION -->|"YES (High Risk >= 50%)"| DANGER_UI["🟡 SimResultScreen (High Risk)<br/>• Projected Liquidity Bar (Red Impact)<br/>• Guardian Angel Warning Speech"]

    SAFE_UI --> ACT_CONFIRM["Action: Confirm Purchase"]
    ACT_CONFIRM --> SAVE_BNPL["Save to simulatedBnplItems[]<br/>Update Monthly Debt Stack"]
    SAVE_BNPL --> RETURN_SAFE["Return to Home<br/>Toast: BNPL Added"]

    DANGER_UI --> ACT_POSTPONE["Action: Postpone to Next Month"]
    ACT_POSTPONE --> RETURN_POSTPONE["Return to Home<br/>Toast: Balance Protected"]

    DANGER_UI --> ACT_PROCEED["Action: Continue to Buy"]
    ACT_PROCEED --> PROCEED_SCREEN["🔥 ProceedAnywayScreen (Psychological Friction)"]

    subgraph FRICTION_MODULE["Behavioral Friction Layers"]
        direction TB
        F_HOURS["Wage Slavery Converter:<br/>Math.round(amount / 15) Hours of Life"]
        F_LIFESTYLE["Zero Buffer Alert:<br/>One Disaster Away From Crisis"]
        F_CHECK["Accountability Checkbox:<br/>'I admit I have zero self-control...'"]
        F_TIMER["Forced 7-Second Cooldown Timer"]
        F_HOURS --> F_LIFESTYLE --> F_CHECK --> F_TIMER
    end

    PROCEED_SCREEN --> FRICTION_MODULE
    FRICTION_MODULE --> CONFIRM_PROCEED["Click 'I Don't Care, Ruin My Finances'"]
    CONFIRM_PROCEED --> ACTIVATE_DANGER["App.jsx: dangerMode = true<br/>Save Purchase to Stack<br/>Home Balance Enters Pulsing Red Alert"]

    style BLOCKED_UI fill:#f3e8ff,stroke:#9333ea,stroke-width:2px
    style SAFE_UI fill:#dcfce7,stroke:#16a34a,stroke-width:2px
    style DANGER_UI fill:#fef3c7,stroke:#d97706,stroke-width:2px
    style PROCEED_SCREEN fill:#450a0a,stroke:#dc2626,color:#fecaca,stroke-width:2px
    style ACTIVATE_DANGER fill:#991b1b,stroke:#ef4444,color:#ffffff,stroke-width:3px
```
